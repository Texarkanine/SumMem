#!/usr/bin/env python3
"""SumMem driver. Agents run this script; they do not write the store."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import random
import shutil
import sys
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path


def _utf8_stdio() -> None:
    for stream in (sys.stdout, sys.stderr):
        reconfigure = getattr(stream, "reconfigure", None)
        if reconfigure is None:
            continue
        try:
            reconfigure(encoding="utf-8")
        except (OSError, ValueError):
            pass


_utf8_stdio()


def note_file_bytes(text: str) -> bytes:
    """Return UTF-8 encoding of *text* plus a single trailing newline."""
    return text.encode("utf-8") + b"\n"


def note_digest(file_bytes: bytes) -> str:
    """Return lowercase hex SHA-256 of *file_bytes*."""
    return hashlib.sha256(file_bytes).hexdigest()


def leafset_id(digests: list[str]) -> str:
    """Return lowercase hex SHA-256 of sorted hex digests joined with no delimiter."""
    join = "".join(sorted(digests))
    return hashlib.sha256(join.encode("ascii")).hexdigest()


@dataclass(frozen=True)
class NoteChild:
    """A raw note child in a canonical tree."""

    name: str
    text: str


@dataclass(frozen=True)
class Tree:
    """Canonical tree: versioned list of note and nap children."""

    kids: list[NoteChild | NapChild]
    v: int = 1


@dataclass(frozen=True)
class NapChild:
    """A nap child. *id* is the leaf-set id of the original notes."""

    id: str
    sum: str
    tree: Tree


def _tree_dict(tree: Tree) -> dict:
    kids = []
    for child in tree.kids:
        if isinstance(child, NoteChild):
            kids.append({"k": "n", "name": child.name, "text": child.text})
        else:
            kids.append(
                {"k": "p", "id": child.id, "sum": child.sum, "tree": _tree_dict(child.tree)}
            )
    return {"v": tree.v, "kids": kids}


def dumps_tree(tree: Tree) -> bytes:
    """Serialize *tree* to canonical JSON bytes with a trailing newline."""
    body = json.dumps(_tree_dict(tree), sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return body.encode("utf-8") + b"\n"


def _tree_from_dict(obj: dict) -> Tree:
    kids: list[NoteChild | NapChild] = []
    for child in obj["kids"]:
        if child["k"] == "n":
            kids.append(NoteChild(name=child["name"], text=child["text"]))
        else:
            kids.append(
                NapChild(id=child["id"], sum=child["sum"], tree=_tree_from_dict(child["tree"]))
            )
    return Tree(v=obj["v"], kids=kids)


def loads_tree(data: bytes) -> Tree:
    """Parse canonical tree bytes into a Tree."""
    return _tree_from_dict(json.loads(data.decode("utf-8")))


ENTRY_CHARS = 280

CONFIG_TEMPLATE = """\
# SumMem per-store knobs. Missing names mean script defaults.
# ENTRY_CHARS = 280
"""


def require_utc(now):
    """Reject *now* unless tzinfo is datetime.timezone.utc."""
    if not isinstance(now, datetime) or now.tzinfo is not timezone.utc:
        raise ValueError("clock must be UTC")
    return now


def find_store_parent(cwd):
    """Walk from *cwd* to the first directory that contains .git, else *cwd*."""
    cur = Path(cwd).resolve()
    for candidate in (cur, *cur.parents):
        if (candidate / ".git").exists():
            return candidate
    return cur


def ensure_store(parent):
    """Create the store under *parent* if missing. Never overwrite an existing driver."""
    store = Path(parent) / ".summem"
    (store / "notes").mkdir(parents=True, exist_ok=True)
    driver = store / "summem"
    if not driver.exists():
        shutil.copy2(Path(__file__).resolve(), driver)
        os.chmod(driver, 0o755)
    config = store / "config.toml"
    if not config.exists():
        config.write_text(CONFIG_TEMPLATE, encoding="utf-8")
    return store


def write_note(parent, text, now, rng):
    """Validate *text*, write one immutable note under *parent*, return its path."""
    require_utc(now)
    if text == "":
        raise ValueError("note is empty")
    if "\n" in text or "\r" in text:
        raise ValueError("note must be one line")
    if len(text.encode("utf-8")) > ENTRY_CHARS:
        raise ValueError("note is too long")
    notes = ensure_store(parent) / "notes"
    name = f"{now.strftime('%Y%m%dT%H%M%SZ')}-{rng.randbytes(8).hex()}"
    dest = notes / name
    tmp = notes / f".tmp-{os.urandom(8).hex()}"
    tmp.write_bytes(note_file_bytes(text))
    os.replace(tmp, dest)
    return dest


def wake_text(parent) -> str:
    """Return the wait-free listing of loose notes under *parent*, or empty."""
    notes = ensure_store(parent) / "notes"
    lines = []
    paths = sorted(p for p in notes.iterdir() if p.is_file() and not p.name.startswith("."))
    for path in paths:
        try:
            raw = path.read_bytes()
            text = raw.decode("utf-8")
        except (OSError, UnicodeDecodeError):
            continue
        if text.endswith("\n"):
            text = text[:-1]
        cid = leafset_id([note_digest(raw)])
        day = f"{path.name[0:4]}-{path.name[4:6]}-{path.name[6:8]}"
        lines.append(f"{cid}  (1 note, from {day})  {text}")
    if not lines:
        return ""
    return "\n".join(lines) + "\n"


def require_python(version_info: tuple[int, ...] = sys.version_info) -> None:
    """Refuse to run on Python older than 3.11."""
    if version_info < (3, 11):
        sys.stderr.write("SumMem needs Python 3.11 or newer\n")
        raise SystemExit(1)


def main(argv: list[str] | None = None) -> int:
    """Run wake or note. Return 0 on success, 2 on usage, 1 on validation."""
    require_python()
    parser = argparse.ArgumentParser(prog="summem")
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("wake")
    note = sub.add_parser("note")
    note.add_argument("text")
    try:
        args = parser.parse_args(argv)
    except SystemExit as exc:
        return 0 if exc.code is None else int(exc.code)
    parent = find_store_parent(Path.cwd())
    if args.cmd == "wake":
        sys.stdout.write(wake_text(parent))
        return 0
    try:
        write_note(parent, args.text, datetime.now(timezone.utc), random.SystemRandom())
    except ValueError as exc:
        sys.stderr.write(f"{exc}\n")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
