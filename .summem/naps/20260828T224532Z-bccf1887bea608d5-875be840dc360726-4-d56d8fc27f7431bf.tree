{"c":[{"id":"6d3d53d6fdf41b4e","sum":"Membership: another contributor needs it to work on this repository, not in this clone; how-to denylist is PR opened / checks passed / task archived.","tree":{"c":[{"name":"20260828T224532Z-bccf1887bea608d5","text":"note membership probe is work in this clone; how-to denylist is PR opened / checks passed / task archived","type":"note"},{"name":"20260829T000716Z-4f13dab49598cbb6","text":"Membership wording: say 'work on this repository', not 'work in this clone'; contributors have separate checkouts.","type":"note"}]},"type":"nap"},{"id":"24fb43f4be5c6f63","sum":"prompt_text and how_to_text keep the short membership phrase direct; AGENTS.md lockstep covers the bootstrap copy. Factoring MEMBERSHIP_PROBE harms readability for negligible benefit.","tree":{"c":[{"name":"20260829T001244Z-53dde24650751d3f","text":"prompt_text and how_to_text share MEMBERSHIP_PROBE; AGENTS.md lockstep covers the bootstrap copy.","type":"note"},{"name":"20260829T002301Z-2fe1954978d4b4e4","text":"Keep the short membership phrase direct in prompt_text and how_to_text; factoring it harms readability for negligible benefit.","type":"note"}]},"type":"nap"}]}
