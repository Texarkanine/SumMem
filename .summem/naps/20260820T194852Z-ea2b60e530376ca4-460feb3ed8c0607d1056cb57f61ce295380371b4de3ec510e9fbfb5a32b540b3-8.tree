{"c":[{"id":"1b57bafcd1f51c0854547c5c392af690292a130b6f63f1132a03dcdfa190d8ca","sum":"Onboarding is summem init (prompt_text()); version-tracking archived (PR #22): version prints __version__, Release Please extra-files; consumer Actions YAML is not product TDD.","tree":{"c":[{"id":"9280565a8f63c4956ac8d3f5446630be6b3c85a440463d011060867023721db9","sum":"Onboarding is summem init (prompt_text()), not a docs/agents-prompt.md copy. summem version prints __version__; Release Please extra-files bump repo-root summem.","tree":{"c":[{"name":"20260820T194852Z-ea2b60e530376ca4","text":"ship-prompt-file archived; onboarding is docs/agents-prompt.md; draft PR #21.","type":"note"},{"name":"20260820T195810Z-0def08186d21b807","text":"summem version prints __version__; Release Please simple extra-files bump repo-root summem via x-release-please-version.","type":"note"}]},"type":"nap"},{"id":"eacada5aac0af2308d844dbea814a4a3047786b1b599cd8a02ba9d20622eec05","sum":"version-tracking archived (PR #22): summem version prints __version__; Release Please extra-files; consumer Actions YAML is not product TDD (same class as .cursor-rules#116).","tree":{"c":[{"name":"20260820T195859Z-a205a695beb1a648","text":"Preflight FAIL on consumer release-please.yaml was the same class as Texarkanine/.cursor-rules#116 (TDD encoding of tooling as product).","type":"note"},{"name":"20260820T203536Z-5ee598da385c9137","text":"version-tracking archived: summem version prints __version__; Release Please simple extra-files on repo-root summem; PR #22.","type":"note"}]},"type":"nap"}]},"type":"nap"},{"id":"94271e53e4e390e8130bd1709e53eac96b5d1cbed1034657ed494aa690aaa715","sum":"Coverage: pytest-cov measures the no-suffix driver; tox -e coverage uploads lcov (PR #23).","tree":{"c":[{"id":"9c098318cdba7a6c04832c0396abf56641778da7500b6cd3e6e9b6cfe7684dba","sum":"pytest-cov --cov=summem measures the no-suffix driver; tox -e coverage writes coverage/lcov.info (lcov SF path summem), while default tox stays coverage-free.","tree":{"c":[{"name":"20260820T204638Z-78eb1773319c702b","text":"pytest-cov --cov=summem measures the no-suffix shebang; lcov SF path is summem.","type":"note"},{"name":"20260820T205716Z-2ff58bd8d1240b01","text":"tox -e coverage writes coverage/lcov.info via pytest-cov --cov=summem; default tox stays coverage-free.","type":"note"}]},"type":"nap"},{"id":"e4a889eeb8ef62b88773baa366c199c12511bb1cf2605c973ee38a71666b63c7","sum":"Draft PR #23 archived: tox -e coverage uploads lcov to Codecov; README badge.","tree":{"c":[{"name":"20260820T210212Z-1d110b7fc5fdd2af","text":"Draft PR #23: tox -e coverage uploads lcov to Codecov; README badge.","type":"note"},{"name":"20260820T213032Z-d2f8289f08d361a6","text":"codecov-upload archived: tox -e coverage uploads lcov; README badge; draft PR #23.","type":"note"}]},"type":"nap"}]},"type":"nap"}]}
