{"c":[{"id":"78d34186f9c1d6212e59b18ec9392c63d27fa6c13bc9d03d3649719cd1233381","sum":"Perf shards #49/#50: catalog via one git ls-files of .summem/config.toml; recall/zoom unique-prefix once (sort+neighbor LCP) and parse each view .tree at most once; named_ids shares that walk. Wave was #49∥#50 then #51 then #53 then #52.","tree":{"c":[{"id":"0302e7603c8f235aaaec03afda4030a4b627b2bea4794eba2df5f6572ab19106","sum":"Perf shards filed: #49 catalog ls-files, #50 recall/zoom prefix+parse-once, #51 heal raw-JSON, #52 drop-dataclasses, #53 skip-heal (design). Wave #49∥#50 then #51 then #53 then #52; close/defer ok.","tree":{"c":[{"name":"20260825T192652Z-f5aecd1900237e75","text":"Perf shards filed: #49 catalog ls-files, #50 recall/zoom prefix+parse-once, #51 heal raw-JSON walk, #52 startup dataclasses/lazy-import, #53 skip-heal marker (design)","type":"note"},{"name":"20260825T193539Z-a762122c1565c2e3","text":"perf-shards L4: #49∥#50 then #51 then #53 then #52; parent operator; close/defer ok; parent L4 files stay off main until capstone.","type":"note"}]},"type":"nap"},{"id":"f05f9b5376fd649a3cf30a7e1f781fdb6dc44e1389a519d39800875a661a52ef","sum":"Issues #49/#50: catalog via one git ls-files of .summem/config.toml; recall/zoom unique-prefix once (sort+neighbor LCP) and parse each view .tree at most once; named_ids shares that walk.","tree":{"c":[{"name":"20260825T193914Z-a87c411d06c19c31","text":"Issue #50: recall/zoom unique-prefix once per command (sort+neighbor LCP) and parse each view .tree at most once; named_ids shares that walk. Catalog/heal/dataclasses stay out.","type":"note"},{"name":"20260825T193954Z-611094457cb3dfa9","text":"Issue #49 plan: catalog_text becomes one git ls-files -z --cached --others --exclude-standard filtered for .summem/config.toml; _ignored_store goes away.","type":"note"}]},"type":"nap"}]},"type":"nap"},{"id":"3def4ffb3ddeacd7a6550fcd4feb54409763dcd71626c3a49cd1296c060c5a02","sum":"Catalog is one git ls-files of .summem/config.toml; recall/