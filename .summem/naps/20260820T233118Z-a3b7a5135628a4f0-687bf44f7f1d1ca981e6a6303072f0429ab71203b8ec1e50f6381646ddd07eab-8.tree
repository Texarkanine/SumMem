{"c":[{"id":"75ea440c81cc93d73967ebb5c779efa82c4a660c10323b2e3db6c81d640d4d49","sum":"Root wake labels a non-empty git-root document; note prints Saved. then maybe a fold request (do not retry); emergency delete is surgery.py, not a subcommand","tree":{"c":[{"id":"08c734f3ed243af8d0a8ebaf38bcb113eaee72ffd2f3eaa7afd7b27a88c47b47","sum":"Root wake labels a non-empty git-root document; emergency delete is surgery.py (zipper out, unlink one note, heal_view), not a subcommand","tree":{"c":[{"name":"20260820T233118Z-a3b7a5135628a4f0","text":"Root wake prints == Project-root Memories == when the git-root document is non-empty, catalog or not. Pull wakes stay unlabeled.","type":"note"},{"name":"20260821T155541Z-842d10e98fbc74de","text":"Emergency delete is repo-root surgery.py, not a summem subcommand: zipper break-out of containing naps, unlink that one note, heal_view; it does not rewrite git history or write nap captions.","type":"note"}]},"type":"nap"},{"id":"8c9885aa12cc2275c410460b0a6571edd29d32f283668f4411bf3511de6e5067","sum":"Successful note prints Saved. then maybe a fold request; the nap is extra work on already-stored memory - do not retry the same note (PR #29 closed #27)","tree":{"c":[{"name":"20260821T160046Z-f394b9340bcc2577","text":"Successful summem note prints Saved. then maybe a fold request. A nap after note is extra work on already-stored memory; do not retry the same note.","type":"note"},{"name":"20260821T160735Z-ea1c2c79f1a46533","text":"Draft PR #29 feat/note-ack closes #27: successful note prints Saved. then maybe a fold request; do not retry the same note.","type":"note"}]},"type":"nap"}]},"type":"nap"},{"id":"4d2319ab67d787e7960b565eeb139251072a7ae48f1b78fb5880dd1721ae00e1","sum":"note-ack-surgery L4 capped (#29+#30); program is AGPL, 0BSD prompt and §7 invocation live only in the summem header; LICENSE verbatim; surgery.py stock AGPL (PR #32)","tree":{"c":[{"id":"98bd8ec9648a6a8bbe5f66081dd5996ac1f292d8561ab2a8746452a425f68abb","sum":"note-ack-surgery L4 capped (#29+#30 merged, archive on main). Program is AGPL; 0BSD prompt and §7 invocation permission live in the summem header (authoritative); LICENSE stays verbatim AGPL; surgery.py echoes invocation only.","tree":{"c":[{"name":"20260821T172411Z-b5e0645705ca3183","text":"L4 note-ack-surgery capped: #29 and #30 merged; capstone archive memory-bank/archive/enhancements/20260821-note-ack-surgery.md on main.","type":"note"},{"name":"20260823T191515Z-afdba13a71a9e2b8","text":"Program is AGPL; prompt template is 0BSD and invocation is a section 7 additional permission, both in the summem header (authoritative). LICENSE stays verbatim AGPL; surgery.py echoes invocation only.","type":"note"}]},"type":"nap"},{"id":"55a93401f0823aa511816d387141a4a761b64ffc0a62e58b800626198c0fc4ac","sum":"surgery.py stays stock AGPL; §7 invocation + 0BSD prompt live only in the summem header; agpl-carve-outs archived as PR #32","tree":{"c":[{"name":"20260823T191944Z-6b284f7ab99096b8","text":"surgery.py stays stock AGPL. The section 7 invocation permission and 0BSD prompt terms live only in the summem header.","type":"note"},{"name":"20260823T193232Z-015b467b7a2c8879","text":"agpl-carve-outs archived to memory-bank/archive/enhancements/20260823-agpl-carve-outs.md; draft PR #32.","type":"note"}]},"type":"nap"}]},"type":"nap"}]}
