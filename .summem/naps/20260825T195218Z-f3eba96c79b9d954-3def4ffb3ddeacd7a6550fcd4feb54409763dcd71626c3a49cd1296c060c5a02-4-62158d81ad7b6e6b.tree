{"c":[{"id":"fb6c804b59655564bfacee6685b091bd999953f992a6fafe3a6455344aabd5e1","sum":"catalog is one git ls-files of .summem/config.toml; recall/zoom unique-prefix once and parse each view .tree once (#50).","tree":{"c":[{"name":"20260825T195218Z-f3eba96c79b9d954","text":"Root catalog enumerates via one git ls-files --cached --others --exclude-standard filtered on .summem/config.toml; no committed index.","type":"note"},{"name":"20260825T200439Z-dff2e8353bdc9000","text":"recall-zoom-prefix archived: recall/zoom unique-prefix once per command (sort+neighbor LCP) and parse each view .tree at most once; named_ids shares that walk. Issue #50.","type":"note"}]},"type":"nap"},{"id":"f3a4c22a002e4dd6ceda8c0f66ebdecda0119e980a1a8661a254ae264384efe0","sum":"heal overlap is raw JSON; rematerialize and write_nap still build Tree. PR #56 Fixes #51.","tree":{"c":[{"name":"20260825T200855Z-2670ea812d7405e3","text":"Issue #51: heal digest walk is raw JSON only; rematerialize and write_nap still build Tree when writing a pack.","type":"note"},{"name":"20260825T202339Z-0c3a676acf423f91","text":"Heal overlap checks walk raw tree JSON; note/nap thread one list_view and knobs. PR #56 Fixes #51.","type":"note"}]},"type":"nap"}]}
