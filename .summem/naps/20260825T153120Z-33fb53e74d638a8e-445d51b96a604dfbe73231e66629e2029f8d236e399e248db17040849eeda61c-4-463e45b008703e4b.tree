{"c":[{"id":"fadfed630d13aa36de4907f3960e3a820ff62d3d5caeff53d02491090e755046","sum":"Nap captions are .summ, not .sum; leftover .sum beside a .tree is not a caption. Consumer find recipe is on PR #47 for the squash BREAKING CHANGES footer.","tree":{"c":[{"name":"20260825T153120Z-33fb53e74d638a8e","text":"Nap caption files are .summ; a leftover .sum beside a .tree is not a caption.","type":"note"},{"name":"20260825T160856Z-79b76d35d66fe702","text":"summ-caption-suffix archived: captions are .summ; consumer find recipe on PR #47 for squash BREAKING CHANGES.","type":"note"}]},"type":"nap"},{"id":"7d9b22491a29a83688ccf44cc74deeb29da0ad2c6fcc6761f0efe4735558827c","sum":"SLOBAC 2026-08-25 audit (284 tests) found 63 smells; ratchet applied. Proofs stay as file-backend acceptance; the 3.11-floor pin stays because CI has no 3.10.","tree":{"c":[{"name":"20260825T174056Z-e79674666263e761","text":"2026-08-25 SLOBAC all-smells audit of tests/ (284 tests): 63 deduplicated findings; largest clusters loose-text-oracle 30, vacuous-assertion 12, implementation-coupled 10; cross-suite confirmed 4 redundancies and proof-file fossils.","type":"note"},{"name":"20260825T180628Z-7d45f92e68433516","text":"SLOBAC 2026-08-25 ratchet applied to tests: proofs kept as file-backend acceptance; CI has no 3.10 so the source-order 3.11-floor pin stays.","type":"note"}]},"type":"nap"}]}
