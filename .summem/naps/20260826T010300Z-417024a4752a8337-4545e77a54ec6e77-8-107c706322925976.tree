{"c":[{"id":"45cf7d8ae1c3a941","sum":"local tox: run-parallel, session fixture, no --basetemp; CI matrix on PR, coverage only on main","tree":{"c":[{"id":"36328cf904c2428a","sum":"local tox: run-parallel, session fixture, no --basetemp; nap-variant-stems archived","tree":{"c":[{"name":"20260826T010300Z-417024a4752a8337","text":"nap-variant-stems archived to memory-bank/archive/enhancements/20260825-nap-variant-stems.md; draft PR #62; PR review all dismissed","type":"note"},{"name":"20260826T012700Z-be1b409a2bdf91a3","text":"Full local tox is tox run-parallel; pytest --basetemp is TMPDIR/summem-{env} so outside-repo tests stay outside the clone; tests load summem via a session fixture.","type":"note"}]},"type":"nap"},{"id":"e9d850f97d191356","sum":"tox: run-parallel locally, no --basetemp, session fixture; CI matrix on PR, coverage only on main","tree":{"c":[{"name":"20260826T014547Z-7e85524296498ed1","text":"Full local tox is tox run-parallel; do not pass pytest --basetemp (default already isolates outside the clone). Tests cache summem in conftest._SUMMEM because migrate.py and surgery.py overwrite sys.modules['summem'].","type":"note"},{"name":"20260826T020511Z-dedaa99398372c27","text":"CI runs tox py311-py314 on pull requests and on main; tox -e coverage and the Codecov upload run only on pushes to main.","type":"note"}]},"type":"nap"}]},"type":"nap"},{"id":"ac119d66989496d0","sum":"Local tox: run-parallel; each env pytest -n auto --maxprocesses=4; coverage serial. PR CI is pr.yaml (py311–py314); main is ci.yaml plus coverage. #65 closed #63; #66 closed #64.","tree":{"c":[{"id":"d3a518852906da6f","sum":"Local tox: run-parallel, session fixture. PR CI is .github/workflows/pr.yaml (py311–py314); main is ci.yaml plus coverage. tox-speedup archived; PR #65 closed #63.","tree":{"c":[{"name":"20260826T020911Z-dc61c4600974926c","text":"PR checks are .github/workflows/pr.yaml (tox py311-py314). Main CI is .github/workflows/ci.yaml (same matrix plus coverage upload).","type":"note"},{"name":"20260826T021234Z-bd17f467296b95fc","text":"tox-speedup archived: local tox run-parallel, session summem fixture, PR/ci workflow split. Draft PR #65 closes #63.","type":"note"}]},"type":"nap"},{"id":"4ef12b6001b08fed","sum":"Each tox env is pytest -n auto --maxprocesses=4; coverage stays serial; 0 serial markers; PR #66 closes #64.","tree":{"c":[{"name":"20260826T024233Z-b9bc41aef5017da0","text":"Each tox env runs pytest -n auto --maxprocesses=4; coverage stays serial. Serial markers: 0. Unbounded auto made tox run-parallel slower.","type":"note"},{"name":"20260826T030409Z-e8788d730d1e85ab","text":"pytest-xdist archived: each tox env is -n auto --maxprocesses=4; 0 serial markers; PR #66 closes #64.","type":"note"}]},"type":"nap"}]},"type":"nap"}]}
