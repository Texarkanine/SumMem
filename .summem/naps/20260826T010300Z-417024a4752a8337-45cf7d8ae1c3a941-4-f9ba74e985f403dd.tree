{"c":[{"id":"36328cf904c2428a","sum":"local tox: run-parallel, session fixture, no --basetemp; nap-variant-stems archived","tree":{"c":[{"name":"20260826T010300Z-417024a4752a8337","text":"nap-variant-stems archived to memory-bank/archive/enhancements/20260825-nap-variant-stems.md; draft PR #62; PR review all dismissed","type":"note"},{"name":"20260826T012700Z-be1b409a2bdf91a3","text":"Full local tox is tox run-parallel; pytest --basetemp is TMPDIR/summem-{env} so outside-repo tests stay outside the clone; tests load summem via a session fixture.","type":"note"}]},"type":"nap"},{"id":"e9d850f97d191356","sum":"tox: run-parallel locally, no --basetemp, session fixture; CI matrix on PR, coverage only on main","tree":{"c":[{"name":"20260826T014547Z-7e85524296498ed1","text":"Full local tox is tox run-parallel; do not pass pytest --basetemp (default already isolates outside the clone). Tests cache summem in conftest._SUMMEM because migrate.py and surgery.py overwrite sys.modules['summem'].","type":"note"},{"name":"20260826T020511Z-dedaa99398372c27","text":"CI runs tox py311-py314 on pull requests and on main; tox -e coverage and the Codecov upload run only on pushes to main.","type":"note"}]},"type":"nap"}]}
